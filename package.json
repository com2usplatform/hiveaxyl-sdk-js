{
  "name": "@com2usplatform/hiveaxyl",
  "version": "1.0.1",
  "description": "Hive Axyl SDK for browser (H5) games",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/com2usplatform/hiveaxyl-sdk-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "npm@11.11.0",
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics.d.ts",
        "default": "./dist/analytics.js"
      },
      "require": {
        "types": "./dist/analytics.d.cts",
        "default": "./dist/analytics.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    },
    "./coupon": {
      "import": {
        "types": "./dist/coupon.d.ts",
        "default": "./dist/coupon.js"
      },
      "require": {
        "types": "./dist/coupon.d.cts",
        "default": "./dist/coupon.cjs"
      }
    },
    "./mailbox": {
      "import": {
        "types": "./dist/mailbox.d.ts",
        "default": "./dist/mailbox.js"
      },
      "require": {
        "types": "./dist/mailbox.d.cts",
        "default": "./dist/mailbox.cjs"
      }
    },
    "./payment": {
      "import": {
        "types": "./dist/payment.d.ts",
        "default": "./dist/payment.js"
      },
      "require": {
        "types": "./dist/payment.d.cts",
        "default": "./dist/payment.cjs"
      }
    },
    "./service": {
      "import": {
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "require": {
        "types": "./dist/service.d.cts",
        "default": "./dist/service.cjs"
      }
    },
    "./tcb": {
      "import": {
        "types": "./dist/tcb.d.ts",
        "default": "./dist/tcb.js"
      },
      "require": {
        "types": "./dist/tcb.d.cts",
        "default": "./dist/tcb.cjs"
      }
    },
    "./token": {
      "import": {
        "types": "./dist/token.d.ts",
        "default": "./dist/token.js"
      },
      "require": {
        "types": "./dist/token.d.cts",
        "default": "./dist/token.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "check": "node scripts/verify.mjs",
    "check:fast": "node scripts/verify.mjs --fast",
    "test": "vitest run",
    "build": "tsdown",
    "pack": "node scripts/pack.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "sync": "node scripts/sync.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.4",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "unpkg": "./dist/hiveaxyl-sdk.iife.js"
}
